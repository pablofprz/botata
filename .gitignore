__pycache__/
*.py[codz]
*$py.class
*.so
build/
dist/
wheels/
*.egg-info/
*.egg
.eggs/
.cache
.pytest_cache/
.ruff_cache/
.mypy_cache/
.dmypy.json
dmypy.json
htmlcov/
