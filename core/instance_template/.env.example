# Credenciales de la instancia — copiá a .env y completá.
# Obligatorias (según canal: BSKY_PASSWORD para bluesky, MASTODON_ACCESS_TOKEN para mastodon):
BSKY_PASSWORD=
MASTODON_ACCESS_TOKEN=
OPENROUTER_API_KEY=
# Opcionales (tools que las usan degradan graceful si faltan):
BRAVE_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
YOUTUBE_API_KEY=
