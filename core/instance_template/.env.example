# Credenciales de la instancia — copiá a .env y completá.
# Obligatorias (según canal: BSKY_PASSWORD para bluesky, MASTODON_ACCESS_TOKEN
# para mastodon, DISCORD_BOT_TOKEN para discord):
BSKY_PASSWORD=
MASTODON_ACCESS_TOKEN=
# Bot del Developer Portal (https://discord.com/developers) con el
# Message Content Intent habilitado, invitado al server con permisos de
# leer/enviar mensajes en los canales de DISCORD_CHANNEL_IDS.
DISCORD_BOT_TOKEN=
# API key del LLM. OPENROUTER_API_KEY y LLM_API_KEY son equivalentes: usá la que
# prefieras con cualquier proveedor OpenAI-compatible (OpenRouter, OpenAI, Groq,
# DeepSeek, un Ollama local...). El endpoint se configura en settings.json
# (OPENAI_ENDPOINT, o la sección MODELS para varios endpoints con fallback).
OPENROUTER_API_KEY=
LLM_API_KEY=
# Opcionales (tools que las usan degradan graceful si faltan):
BRAVE_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
YOUTUBE_API_KEY=
